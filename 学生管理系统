int verifystuid(int id) {
	stu* temp = pt;
	if (pt->next == NULL) { return 0; }
	while (temp->next != NULL) {
		temp = temp->next;
		if (temp->id == id) { printf("输入学号与现有学号重复！请重新输入\n");return 1; }
	}
	return 0;
}
stu* addstudent() {//添加一位新学生
	stu* pnew = (stu*)malloc(sizeof(stu));
	if (pnew == NULL) { printf("pnew malloc fail\n");return NULL; }
	printf("请依次输入：姓名、登陆密码、学号、性别、出生年月日、数学成绩、语文成绩、英语成绩:\n例：xxx xxx123 1001 男 2004/07/22 100 99 98\n(注意学号不可以重复！！！)\n");
	scanf("%s%s%d%s%s%f%f%f", pnew->name, pnew->psd, &pnew->id, pnew->gender, pnew->birth, &pnew->math, &pnew->chinese, &pnew->english);
	if (verifystuid(pnew->id) == 1) {
		while (1) {
			scanf("%d", &pnew->id);
			if (verifystuid(pnew->id) == 0) { break; }
		}
	}
	if (checkgender(pnew->gender) == -1) {
		while (1) {
			scanf("%s", pnew->gender);
			if (checkgender(pnew->gender) == 1) { break; }
		}
	}
	if (checkbirth(pnew->birth) == -1) {
		printf("日期输入非法，请单独重新输入日期即可\n");
		while (1) {
			scanf("%s", pnew->birth);
			if (checkbirth(pnew->birth) == -1) { printf("日期输入非法，请单独重新输入日期即可\n"); }
			if (checkbirth(pnew->birth) == 1) { break; }
		}
	}
	pnew->next = pt->next;
	pt->next = pnew;
	return pt;
}

