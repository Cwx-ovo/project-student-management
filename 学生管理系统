	printf("请依次输入：姓名、登陆密码、学号、性别、出生年月日、:\n例：xxx xxx123 1001 男 2004/07/22 \n(注意工号不可以重复！！！)\n");
	scanf("%s%s%d%s%s", pnew->name, pnew->psd, &pnew->id, pnew->gender, pnew->birth);
	if (verifyteaid(pnew->id) == 1) {
		while (1) {
			scanf("%d", &pnew->id);
			if (verifyteaid(pnew->id) == 0) { break; }
		}
	}

	if (checkgender(pnew->gender) == -1) {
		while (1) {
			scanf("%s", pnew->gender);
			if (checkgender(pnew->gender) == 1) { break; }
		}
	}

	if (checkbirth(pnew->birth) == -1) {
		printf("日期输入非法，请单独重新输入日期即可\n");
		while (1) {
			scanf("%s", pnew->birth);
			if (checkbirth(pnew->birth) == -1) { printf("日期输入非法，请单独重新输入日期即可\n"); }
			if (checkbirth(pnew->birth) == 1) { break; }
		}
	}
	pnew->next = p->next;
	p->next = pnew;
	//新添加的教师就是当前唯一可登录账号，同步到登录实例 teacher
	strcpy(teacher.name, pnew->name);
	strcpy(teacher.psd, pnew->psd);
	teacher.id = pnew->id;
	strcpy(teacher.gender, pnew->gender);
	strcpy(teacher.birth, pnew->birth);
	return p;
}


