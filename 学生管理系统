int deletestudent(int id) {//删除指定id的学生
	stu* del = pt->next;
	if (del == NULL) { printf("无学生可删除\n"); return 0; }
	stu* h = pt;
	while (del != NULL) {
		if (del->id == id) {
			h->next = del->next;
			free(del);
			del = NULL;
			del = h->next;
		}
		else {
			h = h->next;
			del = del->next;
		}
	}
	return 0;
}
