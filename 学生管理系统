void teacherSave() {//把教师链表整体写入 teachers.txt
	FILE* fp = fopen("teachers.txt", "w");
	if (fp == NULL) { printf("teachers.txt 打开失败\n"); return; }
	tea* t = p->next;
	while (t != NULL) {
		fprintf(fp, "%s %s %d %s %s\n",
			t->name, t->psd, t->id, t->gender, t->birth);
		t = t->next;
	}
	fclose(fp);
}

void teacherLoad() {//启动时从 teachers.txt 读入教师链表
	FILE* fp = fopen("teachers.txt", "r");
	if (fp == NULL) return;
	tea* tail = p;
	char name[20], psd[20], gender[20], birth[20];
	int id;
	while (fscanf(fp, "%s %s %d %s %s", name, psd, &id, gender, birth) == 5) {
		tea* q = (tea*)malloc(sizeof(tea));
		if (q == NULL) break;
		strcpy(q->name, name);
		strcpy(q->psd, psd);
		q->id = id;
		strcpy(q->gender, gender);
		strcpy(q->birth, birth);
		q->next = NULL;
		tail->next = q;
		tail = q;
	}
	fclose(fp);
}

tea* teachercreat() {//创建一个教师链表头节点
	p = (tea*)malloc(sizeof(tea));
	if (p == NULL) { printf("p malloc fail\n");return NULL; }
	p->next = NULL;
	return p;
}


int deleteteacher(int id) {//删除指定id的教师
	tea* del = p->next;
	if (del == NULL) { printf("无教师可删除\n"); return 0; }
	tea* h = p;
	while (del != NULL) {
		if (del->id == id) {
			h->next = del->next;
			free(del);
			del = NULL;
			del = h->next;
		}
		else {
			h = h->next;
			del = del->next;
		}
	}
	//删除后重新同步登录实例：链表非空则取头结点（最新教师）
	if (p->next != NULL) {
		strcpy(teacher.name, p->next->name);
		strcpy(teacher.psd, p->next->psd);
		teacher.id = p->next->id;
		strcpy(teacher.gender, p->next->gender);
		strcpy(teacher.birth, p->next->birth);
	}
	return 0;
}

