void inputPassword(char* pwd, int maxLen)//无回显输入函数
{
	int i = 0;
	char ch;
	while (1)
	{
		ch = _getch();
		if (ch == '\r')              // 回车结束
		{
			pwd[i] = '\0';
			break;
		}
		else if (ch == '\b')         // 退格删除
		{
			if (i > 0)
			{
				i--;
				printf("\b \b");     // 光标左移，擦除星号
			}
		}
		else if (i < maxLen - 1)     // 防止数组越界
		{
			pwd[i++] = ch;
			printf("*");            // 显示星号代替明文
		}
	}
	printf("\n");
}

int checkgender(char* p) {
	if (strcmp(p, "男") != 0 && (strcmp(p, "女") != 0)) { printf("性别输入非法，请单独重新输入性别即可\n");return -1; }
	return 1;
}

int checkbirth(const char* s) {
	if (strlen(s) != 10) return -1;
	if (s[4] != '/' || s[7] != '/') { printf("日期格式非法，请单独重新输入日期即可\n"); return -1; }
	// 其余位置必须是数字
	for (int i = 0; i < 10; i++) {
		if (i == 4 || i == 7) continue;
		if (s[i] < '0' || s[i] > '9') { printf("日期格式非法，请单独重新输入日期即可\n");return -1; }
	}
	return 1;
}

