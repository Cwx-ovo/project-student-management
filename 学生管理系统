	float math, chinese, english;
	while (fscanf(fp, "%s %s %d %s %s %f %f %f",
		name, psd, &id, gender, birth, &math, &chinese, &english) == 8) {
		stu* q = (stu*)malloc(sizeof(stu));
		if (q == NULL) break;
		strcpy(q->name, name);
		strcpy(q->psd, psd);
		q->id = id;
		strcpy(q->gender, gender);
		strcpy(q->birth, birth);
		q->math = math;
		q->chinese = chinese;
		q->english = english;
		q->next = NULL;
		tail->next = q;
		tail = q;
	}
	fclose(fp);
}
