void idbubble() {
	stu* prev, * curr, * nxt;
	int swap;
	if (pt->next == NULL) { printf("系统中暂无学生\n");return; }
	do {
		swap = 0;
		prev = pt;
		curr = pt->next;
		nxt = curr->next;
		while (nxt != NULL) {
			if (curr->id > nxt->id) {
				prev->next = nxt;
				curr->next = nxt->next;
				nxt->next = curr;

				prev = nxt;
				nxt = curr->next;
				swap = 1;
			}
			else {
				prev = curr;
				curr = nxt;
				nxt = curr->next;

			}
		}
	} while (swap);
	return;
}
void scorebubble() {
	stu* prev, * curr, * nxt;
	int swap;
	if (pt->next == NULL) { printf("系统中暂无学生\n");return; }
	do {
		swap = 0;
		prev = pt;
		curr = pt->next;
		nxt = curr->next;
		while (nxt != NULL) {
			if ((curr->chinese + curr->math + curr->english) < (nxt->chinese + nxt->english + nxt->math)) {
				prev->next = nxt;
				curr->next = nxt->next;
				nxt->next = curr;
				prev = nxt;
				nxt = curr->next;
				swap = 1;
			}
			else {
				prev = curr;
				curr = nxt;
				nxt = curr->next;
			}
		}
	} while (swap);
	return;
}
