void inputPassword(char* pwd, int maxLen)//无回显输入函数
{
	int i = 0;
	char ch;
	while (1)
	{
		ch = _getch();
		if (ch == '\r')              // 回车结束
		{
			pwd[i] = '\0';
			break;
		}
		else if (ch == '\b')         // 退格删除
		{
			if (i > 0)
			{
				i--;
				printf("\b \b");     // 光标左移，擦除星号
			}
		}
		else if (i < maxLen - 1)     // 防止数组越界
		{
			pwd[i++] = ch;
			printf("*");            // 显示星号代替明文
		}
	}
	printf("\n");
}

